# Shared by all services (see docker-compose.yml for per-service values)
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=change-me-jwt-secret-at-least-32-characters

# Event bus: "mongo" (default, no broker needed) or "rabbitmq"
EVENT_BUS=mongo
EVENT_STORE_URL=mongodb://localhost:27017/ops_events
RABBITMQ_URL=amqp://guest:guest@localhost:5672
